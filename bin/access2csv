#!/usr/bin/env perl

# Thin wrapper: all of the logic, and the documentation used by --help,
# lives in App::Access2CSV so that it can be tested without a subprocess

use strict;
use warnings;
use autodie qw(:all);

use App::Access2CSV;

exit App::Access2CSV->run(@ARGV);

__END__

=head1 NAME

access2csv - Export the tables of a Microsoft Access database to CSV files

=head1 SYNOPSIS

	access2csv [options] database.accdb

Run C<access2csv --help> for the options, or C<access2csv --man> (or
C<perldoc App::Access2CSV>) for the full manual.

=head1 SEE ALSO

L<App::Access2CSV>

=cut
